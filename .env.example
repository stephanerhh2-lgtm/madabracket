# Copie ce fichier en .env.local pour tester sur ton PC.
# Sur Vercel, ajoute ces variables dans Settings > Environment Variables.

# Base de données PostgreSQL (Neon)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_de_la_base

# Clé secrète de connexion : une longue suite de caractères au hasard (32 caractères minimum)
BETTER_AUTH_SECRET=remplace-par-une-longue-chaine-aleatoire

# Adresse publique du site
BETTER_AUTH_URL=https://madabracket.vercel.app
